NODE_ENV=development
PORT=3000

# MariaDB (radius DB) — SSH tunnel over Tailscale in dev, see CLAUDE.md
DATABASE_URL="mysql://radius:<password>@127.0.0.1:3306/radius"
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=radius
DATABASE_USER=radius
DATABASE_PASSWORD=

# Paystack (TEST keys until launch)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Admin auth (single admin user via env for now, see docs/DECISIONS.md)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Customer buy site URL, used for Paystack callback_url
CUSTOMER_APP_URL=http://localhost:3001

# Comma-separated allowed origins for browser CORS (customer/admin client-side fetches).
# Defaults to localhost:3001,3002 if unset — only override for staging/prod domains.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# pfSense/FreeRADIUS sometimes reports Acct-Input/Output-Octets from the NAS's perspective
# rather than the user's, swapping which one is actually download vs upload. Defaults to
# "not inverted" (Output = download, Input = upload — the standard RADIUS convention). Flip to
# "true" only after verifying against a real known-direction transfer on the actual deployment.
RADIUS_INVERT_OCTETS=false

# SendGrid — leave SENDGRID_API_KEY unset in dev; EmailService logs instead of sending.
# Restricted API Key scoped to "Mail Send" only. SUPPORT_EMAIL sends from/to the
# shaddaicommunications.com domain, which has SendGrid Domain Authentication set up — any
# address at that domain works without per-address Single Sender Verification.
SENDGRID_API_KEY=
SUPPORT_EMAIL=support@shaddaicommunications.com

# Omada Controller — device-level session visibility (analytics only, never enforcement).
# Leave unset in dev; OmadaClientService no-ops (empty client list) when not configured.
# Create via Omada Controller UI: Settings -> Platform Integration -> Open API -> Add New App,
# Mode = "Client" (NOT "Authorization Code" - that's for interactive human logins, this
# integration is an unattended background poll). OMADA_OMADAC_ID is shown in the same dialog.
OMADA_BASE_URL=https://127.0.0.1:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_OMADAC_ID=

# Cambium ePMP backhaul link status (analytics only, never enforcement) — leave
# CAMBIUM_SNMP_HOST unset in dev; CambiumSnmpService no-ops (nulls) when not configured.
# Community string should be changed off the device's SNMP default before real launch.
CAMBIUM_SNMP_HOST=
CAMBIUM_SNMP_COMMUNITY=public

# ntfy — self-hosted push topic backing the admin bell (NotificationBell.tsx). Leave unset in
# dev; NtfyService no-ops when not configured. Server instance is bound to 127.0.0.1 only.
NTFY_URL=http://127.0.0.1:8090
NTFY_TOPIC=

# Admin alert emails — same events that hit the ntfy bell (payments, support messages,
# blocklist/trial-abuse hits, waitlist imports) are also emailed here via SendGrid. Leave unset
# to disable; NtfyService.publish() still posts to ntfy either way.
ADMIN_ALERT_EMAIL=

# Quick-access links shown on the admin Network/Usage page ("Manage devices") — jump straight
# into each device's own web UI (reverse-proxied via Caddy, see docker/caddy/Caddyfile on the
# server) without needing LAN access or an SSH tunnel. JSON array of {name, url}. Leave unset for
# an empty list.
MANAGED_DEVICE_LINKS=

# Static registry of wireless APs that aren't Omada-managed (no API this app can poll for live
# clients/signal) — shown read-only on the admin Network/Usage page. JSON array of
# {name, ssid, ipAddress, macAddress}. Leave unset for an empty list. Example:
# KNOWN_ACCESS_POINTS=[{"name":"TL-WR840N (Cambium relay)","ssid":"Shaddai-EXT","ipAddress":"192.168.1.196","macAddress":"60:a4:b7:dc:7f:2b"}]
KNOWN_ACCESS_POINTS=

# Web Push (RFC 8030) — used both for customer per-voucher session alerts (apps/customer) and
# real OS-level admin alerts (apps/admin), alongside ntfy/email. Leave unset in dev; PushService
# no-ops (logs a warning) when not configured. Generate a pair with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY in apps/customer/.env and apps/admin/.env must match VAPID_PUBLIC_KEY here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@shaddaicommunications.com
