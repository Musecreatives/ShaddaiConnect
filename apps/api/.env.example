NODE_ENV=development
PORT=3000

# MariaDB (radius DB) — SSH tunnel over Tailscale in dev, see CLAUDE.md
DATABASE_URL="mysql://radius:<password>@127.0.0.1:3306/radius"
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=radius
DATABASE_USER=radius
DATABASE_PASSWORD=

# Paystack (TEST keys until launch)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Admin auth (single admin user via env for now, see docs/DECISIONS.md)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Customer buy site URL, used for Paystack callback_url
CUSTOMER_APP_URL=http://localhost:3001

# Comma-separated allowed origins for browser CORS (customer/admin client-side fetches).
# Defaults to localhost:3001,3002 if unset — only override for staging/prod domains.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# pfSense/FreeRADIUS sometimes reports Acct-Input/Output-Octets from the NAS's perspective
# rather than the user's, swapping which one is actually download vs upload. Defaults to
# "not inverted" (Output = download, Input = upload — the standard RADIUS convention). Flip to
# "true" only after verifying against a real known-direction transfer on the actual deployment.
RADIUS_INVERT_OCTETS=false
