generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                     Int       @id @default(autoincrement()) @db.UnsignedInt
  phone                  String?   @db.VarChar(20)
  email                  String?   @db.VarChar(128)
  name                   String?   @db.VarChar(128)
  locationNote           String?   @map("location_note") @db.VarChar(255)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  /** Manually-triggered upsell email (see CustomersService.notifyTrialUpsell) — set once sent so
   * re-clicking the admin button doesn't re-email the same trial-only customer. */
  trialUpsellSentAt      DateTime? @map("trial_upsell_sent_at") @db.Timestamp(0)
  /** Manually-triggered "your payment didn't go through" nudge (notifyFailedPayments) — same
   * one-shot-per-customer dedup as trialUpsellSentAt. */
  paymentReminderSentAt  DateTime? @map("payment_reminder_sent_at") @db.Timestamp(0)

  @@index([phone], map: "phone")
  @@map("customers")
}

model Device {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  voucherId  Int       @map("voucher_id") @db.UnsignedInt
  macAddress String    @map("mac_address") @db.VarChar(17)
  firstSeen  DateTime  @default(now()) @map("first_seen") @db.Timestamp(0)
  lastSeen   DateTime? @map("last_seen") @db.Timestamp(0)

  @@index([macAddress], map: "mac_address")
  @@index([voucherId], map: "voucher_id")
  @@map("devices")
}

model Nas {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
  nasname     String  @db.VarChar(128)
  shortname   String? @db.VarChar(32)
  type        String? @default("other") @db.VarChar(30)
  ports       Int?
  secret      String  @default("secret") @db.VarChar(60)
  server      String? @db.VarChar(64)
  community   String? @db.VarChar(50)
  description String? @default("RADIUS Client") @db.VarChar(200)

  @@index([nasname], map: "nasname")
  @@map("nas")
}

model Payment {
  id                Int           @id @default(autoincrement()) @db.UnsignedInt
  paystackReference String        @unique(map: "paystack_reference") @map("paystack_reference") @db.VarChar(100)
  voucherId         Int?          @map("voucher_id") @db.UnsignedInt
  planId            Int?          @map("plan_id") @db.UnsignedInt
  customerId        Int?          @map("customer_id") @db.UnsignedInt
  amountNaira       Decimal       @map("amount_naira") @db.Decimal(10, 2)
  status            PaymentStatus @default(pending)
  rawPayload        String?       @map("raw_payload") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([voucherId], map: "voucher_id")
  @@map("payments")
}

model Plan {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  name              String    @db.VarChar(64)
  planType          PlanType  @map("plan_type")
  priceNaira        Decimal   @map("price_naira") @db.Decimal(10, 2)
  durationHours     Int?      @map("duration_hours") @db.UnsignedInt
  validityDays      Int?      @map("validity_days") @db.UnsignedInt
  simultaneousUse   Int       @default(1) @map("simultaneous_use") @db.UnsignedInt
  dataCapMb         BigInt?   @map("data_cap_mb") @db.UnsignedBigInt
  bandwidthDownKbps Int?      @map("bandwidth_down_kbps") @db.UnsignedInt
  bandwidthUpKbps   Int?      @map("bandwidth_up_kbps") @db.UnsignedInt
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  vouchers          Voucher[]

  @@map("plans")
}

model RadAcct {
  radAcctId           BigInt    @id @default(autoincrement()) @map("radacctid") @db.UnsignedBigInt
  acctSessionId       String    @default("") @map("acctsessionid") @db.VarChar(64)
  acctUniqueId        String    @unique(map: "acctuniqueid") @default("") @map("acctuniqueid") @db.VarChar(32)
  username            String    @default("") @db.VarChar(64)
  realm               String?   @default("") @db.VarChar(64)
  nasIpAddress        String    @default("") @map("nasipaddress") @db.VarChar(15)
  nasPortId           String?   @map("nasportid") @db.VarChar(32)
  nasPortType         String?   @map("nasporttype") @db.VarChar(32)
  acctStartTime       DateTime? @map("acctstarttime") @db.DateTime(0)
  acctUpdateTime      DateTime? @map("acctupdatetime") @db.DateTime(0)
  acctStopTime        DateTime? @map("acctstoptime") @db.DateTime(0)
  acctInterval        Int?      @map("acctinterval")
  acctSessionTime     Int?      @map("acctsessiontime") @db.UnsignedInt
  acctAuthentic       String?   @map("acctauthentic") @db.VarChar(32)
  connectInfoStart    String?   @map("connectinfo_start") @db.VarChar(50)
  connectInfoStop     String?   @map("connectinfo_stop") @db.VarChar(50)
  acctInputOctets     BigInt?   @map("acctinputoctets")
  acctOutputOctets    BigInt?   @map("acctoutputoctets")
  calledStationId     String    @default("") @map("calledstationid") @db.VarChar(50)
  callingStationId    String    @default("") @map("callingstationid") @db.VarChar(50)
  acctTerminateCause  String    @default("") @map("acctterminatecause") @db.VarChar(32)
  serviceType         String?   @map("servicetype") @db.VarChar(32)
  framedProtocol      String?   @map("framedprotocol") @db.VarChar(32)
  framedIpAddress     String    @default("") @map("framedipaddress") @db.VarChar(15)
  framedipv6address   String    @default("") @db.VarChar(45)
  framedipv6prefix    String    @default("") @db.VarChar(45)
  framedinterfaceid   String    @default("") @db.VarChar(44)
  delegatedipv6prefix String    @default("") @db.VarChar(45)

  @@index([acctSessionTime], map: "acctsessiontime")
  @@index([acctStartTime], map: "acctstarttime")
  @@index([acctStopTime], map: "acctstoptime")
  @@index([nasIpAddress], map: "nasipaddress")
  @@index([username], map: "username")
  @@index([delegatedipv6prefix], map: "delegatedipv6prefix")
  @@index([framedinterfaceid], map: "framedinterfaceid")
  @@index([framedipv6address], map: "framedipv6address")
  @@index([framedipv6prefix], map: "framedipv6prefix")
  @@map("radacct")
}

model RadCheck {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("==") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([username(length: 32)], map: "username")
  @@map("radcheck")
}

model RadGroupCheck {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  groupname String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("==") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([groupname(length: 32)], map: "groupname")
  @@map("radgroupcheck")
}

model RadGroupReply {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  groupname String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("=") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([groupname(length: 32)], map: "groupname")
  @@map("radgroupreply")
}

model RadPostAuth {
  id       Int      @id @default(autoincrement()) @db.UnsignedInt
  username String   @default("") @db.VarChar(64)
  pass     String   @default("") @db.VarChar(64)
  reply    String   @default("") @db.VarChar(32)
  authDate DateTime @default(now()) @map("authdate") @db.Timestamp(0)

  @@index([username], map: "username")
  @@map("radpostauth")
}

model RadReply {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("=") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([username(length: 32)], map: "username")
  @@map("radreply")
}

model RadUserGroup {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  groupname String @default("") @db.VarChar(64)
  priority  Int    @default(1)

  @@index([username(length: 32)], map: "username")
  @@map("radusergroup")
}

model Voucher {
  id                      Int           @id @default(autoincrement()) @db.UnsignedInt
  code                    String        @unique(map: "code") @db.VarChar(32)
  planId                  Int           @map("plan_id") @db.UnsignedInt
  customerId              Int?          @map("customer_id") @db.UnsignedInt
  status                  VoucherStatus @default(unused)
  simultaneousUseOverride Int?          @map("simultaneous_use_override") @db.UnsignedInt
  amountPaid              Decimal?      @map("amount_paid") @db.Decimal(10, 2)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  activatedAt             DateTime?     @map("activated_at") @db.DateTime(0)
  feedbackRequestedAt     DateTime?     @map("feedback_requested_at") @db.Timestamp(0)
  expiresAt               DateTime?     @map("expires_at") @db.DateTime(0)
  plan                    Plan          @relation(fields: [planId], references: [id], onUpdate: Restrict, map: "fk_voucher_plan")

  @@index([planId], map: "plan_id")
  @@index([status], map: "status")
  @@map("vouchers")
}

model AdminUser {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  email        String   @unique(map: "email") @db.VarChar(128)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String?  @db.VarChar(128)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("admin_users")
}

model Waitlist {
  id                 Int            @id @default(autoincrement()) @db.UnsignedInt
  name               String?        @db.VarChar(128)
  phone              String?        @db.VarChar(20)
  email              String?        @db.VarChar(128)
  locationNote       String?        @map("location_note") @db.VarChar(255)
  source             WaitlistSource @default(form)
  confirmationSentAt DateTime?      @map("confirmation_sent_at") @db.Timestamp(0)
  /// Free-form survey answers (usage patterns, pricing feedback, referrals) captured on the
  /// full waitlist form — stored as a JSON string rather than one rigid column per question,
  /// since most of this is one-time market-research signal, not something the app queries or
  /// filters on. Parse/stringify at the call site.
  surveyResponses    String?        @map("survey_responses") @db.LongText
  notifiedAt         DateTime?      @map("notified_at") @db.Timestamp(0)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([email], map: "email")
  @@index([phone], map: "phone")
  @@map("waitlist")
}

model NasReload {
  nasIpAddress String   @id @map("nasipaddress") @db.VarChar(15)
  reloadTime   DateTime @map("reloadtime") @db.DateTime(0)

  @@map("nasreload")
}

model TrialFeedback {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  voucherId      Int      @map("voucher_id") @db.UnsignedInt
  signalQuality  String?  @map("signal_quality") @db.VarChar(32)
  wouldBuy       String?  @map("would_buy") @db.VarChar(16)
  locationNote   String?  @map("location_note") @db.VarChar(255)
  comments       String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([voucherId], map: "voucher_id")
  @@map("trial_feedback")
}

model VoucherNotification {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  voucherCode String   @map("voucher_code") @db.VarChar(32)
  title       String   @db.VarChar(128)
  body        String   @db.VarChar(255)
  sentAt      DateTime @default(now()) @map("sent_at") @db.Timestamp(0)

  @@index([voucherCode], map: "voucher_code")
  @@map("voucher_notifications")
}

model PushSubscription {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  endpoint     String   @unique(map: "endpoint") @db.VarChar(500)
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  voucherCode  String?  @map("voucher_code") @db.VarChar(32)
  adminEmail   String?  @map("admin_email") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([voucherCode], map: "voucher_code")
  @@index([adminEmail], map: "admin_email")
  @@map("push_subscriptions")
}

model BlockedMac {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  macAddress        String   @unique(map: "mac_address") @map("mac_address") @db.VarChar(50)
  reason            String?  @db.VarChar(255)
  blockedByAdminId  Int?     @map("blocked_by_admin_id") @db.UnsignedInt
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("blocked_macs")
}

model AdminActionLog {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  adminEmail String   @map("admin_email") @db.VarChar(255)
  adminId    Int?     @map("admin_id") @db.UnsignedInt
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id") @db.VarChar(64)
  detail     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([targetType, targetId], map: "target_idx")
  @@map("admin_action_logs")
}

model SupportTicket {
  id            Int                 @id @default(autoincrement()) @db.UnsignedInt
  customerName  String              @map("customer_name") @db.VarChar(128)
  customerEmail String              @map("customer_email") @db.VarChar(128)
  message       String              @db.Text
  priority      SupportPriority     @default(medium)
  status        SupportTicketStatus @default(open)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([status], map: "status")
  @@map("support_tickets")
}

enum PlanType {
  hourly
  monthly

  @@map("plans_plan_type")
}

enum VoucherStatus {
  unused
  active
  expired
  disabled

  @@map("vouchers_status")
}

enum PaymentStatus {
  pending
  success
  failed

  @@map("payments_status")
}

enum WaitlistSource {
  form
  import

  @@map("waitlist_source")
}

enum SupportPriority {
  low
  medium
  high

  @@map("support_tickets_priority")
}

enum SupportTicketStatus {
  open
  resolved

  @@map("support_tickets_status")
}
