NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Shown read-only on the admin Settings/Support pages — mirror the same values set in
# apps/customer/.env(.example). Not secrets, just contact info.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Web Push public key — must match VAPID_PUBLIC_KEY in apps/api/.env. Powers the "Enable push"
# button in NotificationBell.tsx for real OS-level admin alerts (see apps/admin/public/sw.js).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
